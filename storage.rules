rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == "ahmeda9a99a9@gmail.com" ||
        request.auth.token.email == "proboizgaming122@gmail.com"
      );
    }

    // Public read for all app store assets, images, and APK files
    match /{allPaths=**} {
      allow read: if true;
    }

    // Profile photos: max 5MB, image only
    match /profiles/{userId}/{allPaths=**} {
      allow write: if (isSignedIn() && request.auth.uid == userId &&
                      request.resource.size <= 5 * 1024 * 1024) || isAdmin();
      allow delete: if (isSignedIn() && request.auth.uid == userId) || isAdmin();
    }

    // User-isolated apps folder: only owner or admin can write
    match /users/{userId}/apps/{appId}/{subFolder}/{fileName} {
      allow write: if (isSignedIn() && request.auth.uid == userId &&
                      request.resource.size <= 100 * 1024 * 1024) || isAdmin();
      allow delete: if (isSignedIn() && request.auth.uid == userId) || isAdmin();
    }

    // Direct app path fallback
    match /apps/{appId}/{subFolder}/{allPaths=**} {
      allow write: if (isSignedIn() &&
                      request.resource.size <= 100 * 1024 * 1024) || isAdmin();
      allow delete: if isSignedIn() || isAdmin();
    }
  }
}
