rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == "ahmeda9a99a9@gmail.com" ||
        request.auth.token.email == "proboizgaming122@gmail.com"
      );
    }

    function isNotBanned() {
      return isSignedIn() && (!exists(/databases/$(database)/documents/banned_users/$(request.auth.uid)));
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    function isValidString(str, minLen, maxLen) {
      return str is string && str.size() >= minLen && str.size() <= maxLen;
    }

    // Default catch-all: closed by default
    match /{document=**} {
      allow read, write: if false;
    }

    // Test connection doc (for connectivity checking)
    match /test/connection {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Public user profiles (name, bio, link, photoURL, createdAt)
    match /users/{userId} {
      allow read: if true;
      allow create: if isOwner(userId) && isNotBanned() &&
                      isValidString(request.resource.data.displayName, 1, 60);
      allow update: if isOwner(userId) && isNotBanned() &&
                      isValidString(request.resource.data.displayName, 1, 60);
      allow delete: if isOwner(userId) || isAdmin();
    }

    // Private user documents (email, internal settings, preferences)
    // ONLY readable and writable by the user themselves or verified admins
    match /users_private/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if (isOwner(userId) && isNotBanned()) || isAdmin();
    }

    // Apps catalog
    match /apps/{appId} {
      // Public store catalog read: allows listing approved apps and user querying their apps without permission failures
      allow read: if true;

      // Submission: admin can create directly, logged in non-banned user can submit
      allow create: if (isAdmin() && isSignedIn()) ||
                       (isSignedIn() && isNotBanned() &&
                        request.resource.data.uploaderId == request.auth.uid &&
                        (request.resource.data.status == 'pending' || request.resource.data.status == 'approved') &&
                        isValidString(request.resource.data.name, 2, 80) &&
                        isValidString(request.resource.data.packageName, 3, 120));

      // Updates:
      // 1. Admin can approve/reject/modify anything
      // 2. Owner can update their app metadata
      // 3. Anyone can increment download count counter
      allow update: if isAdmin() ||
                       (isSignedIn() && isNotBanned() &&
                        resource.data.uploaderId == request.auth.uid &&
                        request.resource.data.uploaderId == resource.data.uploaderId) ||
                       (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['downloads']) &&
                        request.resource.data.downloads >= resource.data.downloads);

      // Deletion allowed for owner or admin
      allow delete: if isAdmin() || (isSignedIn() && resource.data.uploaderId == request.auth.uid);

      // Reviews subcollection
      match /reviews/{reviewId} {
        allow read: if true;
        // Enforce 1 review per user by making reviewId == userId
        allow create: if isSignedIn() && isNotBanned() &&
                         reviewId == request.auth.uid &&
                         request.resource.data.userId == request.auth.uid &&
                         request.resource.data.rating >= 1 &&
                         request.resource.data.rating <= 5 &&
                         isValidString(request.resource.data.comment, 3, 1000);
        allow update: if isSignedIn() && isNotBanned() &&
                         resource.data.userId == request.auth.uid &&
                         request.resource.data.userId == request.auth.uid &&
                         request.resource.data.rating >= 1 &&
                         request.resource.data.rating <= 5 &&
                         isValidString(request.resource.data.comment, 3, 1000);
        allow delete: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      }
    }

    // Reports collection (viewable by admins only)
    match /reports/{reportId} {
      allow read: if isAdmin();
      allow create: if isSignedIn() && isNotBanned() &&
                       request.resource.data.reporterId == request.auth.uid &&
                       isValidString(request.resource.data.details, 3, 1000);
      allow update, delete: if isAdmin();
    }

    // Banned users collection
    match /banned_users/{userId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
  }
}
